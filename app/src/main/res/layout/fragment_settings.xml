<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fitsSystemWindows="true">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="24dp"
      android:text="Settings"
      android:textSize="28sp"
      android:textStyle="bold" />

    <!-- DISPLAY SECTION -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="Display"
      android:textColor="?attr/colorPrimary"
      android:textSize="14sp"
      android:textStyle="bold" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/switch_dark_mode"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingVertical="8dp"
      android:text="Dark Theme"
      android:textSize="16sp" />

    <com.google.android.material.divider.MaterialDivider
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginVertical="16dp" />

    <!-- PREFERENCES SECTION -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="Discovery &amp; Search"
      android:textColor="?attr/colorPrimary"
      android:textSize="14sp"
      android:textStyle="bold" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/switch_distance_unit"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingVertical="8dp"
      android:text="Use Metric System (km)"
      android:textSize="16sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
      android:id="@+id/switch_dairy_free"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:paddingVertical="8dp"
      android:text="Highlight Dairy-Free Options"
      android:textSize="16sp" />

    <com.google.android.material.divider.MaterialDivider
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginVertical="16dp" />


    <com.google.android.material.divider.MaterialDivider
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginVertical="16dp" />

    <!-- ACCOUNT & ABOUT -->
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginBottom="8dp"
      android:text="About"
      android:textColor="?attr/colorPrimary"
      android:textSize="14sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/text_app_version"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:paddingVertical="8dp"
      android:text="App Version 1.0.0"
      android:textColor="?android:attr/textColorSecondary"
      android:textSize="14sp" />

  </LinearLayout>
</androidx.core.widget.NestedScrollView>